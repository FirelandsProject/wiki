					</a>
					<a href="https://discord.gg/TFKV3hy43" target="_blank" aria-label="Discord">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.182 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"></path></svg>
					</a>
				</div>
			</div>

			<div class="footer-section links">
				<h3>Resources</h3>
				<ul>
					<li><a href={base || '/'}>Wiki Home</a></li>
					<li><a href={`${base}/docs/`}>Documentation</a></li>
				</ul>
			</div>

			<div class="footer-section links">
				<h3>Community</h3>
				<ul>
					<li><a href="https://discord.gg/TFKV3hy43">Discord Server</a></li>
					<li><a href="https://github.com/FirelandsProject">Contribute</a></li>
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<p>&copy; {today.getFullYear()} <strong>Firelands Core Project</strong>. All rights reserved.</p>
			<p class="credits">Crafted with 🔥 for the open source community.</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: linear-gradient(to bottom, rgba(13, 13, 13, 0.98), rgba(5, 5, 5, 1));
		color: #a0a0a0;
		padding: 4rem 0 1.5rem 0;
		margin-top: 4rem;
		border-top: 2px solid transparent;
		border-image: linear-gradient(to right, transparent, rgb(var(--accent)), transparent) 1;
		font-family: 'Inter', sans-serif;
		position: relative;
		overflow: hidden;
	}

	.site-footer::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(to right, transparent, rgba(var(--accent), 0.5), transparent);
		box-shadow: 0 0 15px rgba(var(--accent), 0.3);
	}

	.footer-container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 4rem;
		margin-bottom: 3rem;
	}

	.footer-logo {
		font-family: 'Metamorphous', serif;
		font-size: 1.8rem;
		color: #ffffff;
		margin: 0 0 1rem 0;
		text-transform: uppercase;
		letter-spacing: 2px;
	}

	.footer-logo span {
		color: rgb(var(--accent));
		font-weight: 300;
	}

	.brand-description {
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
		color: #888;
	}

	.footer-section h3 {
		font-family: 'Metamorphous', serif;
		font-size: 1.1rem;
		color: white;
		margin-bottom: 1.2rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		border-bottom: 1px solid rgba(var(--accent), 0.2);
		display: inline-block;
		padding-bottom: 4px;
	}

	.footer-section ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.footer-section ul li {
		margin-bottom: 0.8rem;
	}

	.footer-section ul a {
		color: #888;
		text-decoration: none;
		transition: all 0.2s ease;
		font-size: 0.9rem;
	}

	.footer-section ul a:hover {
		color: rgb(var(--accent));
		padding-left: 4px;
		text-shadow: 0 0 8px rgba(var(--accent), 0.4);
	}

	.social-links {
		display: flex;
		gap: 1.2rem;
	}

	.social-links a {
		color: #666;
		transition: all 0.3s ease;
	}

	.social-links a:hover {
		color: rgb(var(--accent));
		transform: translateY(-3px);
		filter: drop-shadow(0 0 5px rgba(var(--accent), 0.5));
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding-top: 2rem;
		text-align: center;
		font-size: 0.85rem;
		color: #888;
	}

	.footer-bottom strong {
		color: #bbb;
		font-weight: 500;
	}

	.credits {
		margin-top: 0.5rem;
		font-style: italic;
	}

	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			text-align: center;
		}

		.footer-section h3 {
			display: block;
			width: fit-content;
			margin: 0 auto 1.2rem auto;
		}

		.social-links {
			justify-content: center;
		}

		.footer-section ul a:hover {
			padding-left: 0;
		}
	}
</style>


