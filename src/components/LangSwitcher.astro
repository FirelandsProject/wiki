---
import { switchLocalePath } from "../i18n/utils";
import type { Locale } from "../i18n/ui";

interface Props {
	locale: Locale;
	base: string;
}

const { locale, base } = Astro.props;
const currentPath = Astro.url.pathname;
const enHref = switchLocalePath(currentPath, "en", base);
const esHref = switchLocalePath(currentPath, "es", base);
---

<div class="lang-switcher">
	<a href={enHref} class:list={["lang-btn", { active: locale === "en" }]} aria-current={locale === "en" ? "page" : undefined}>
		EN
	</a>
	<a href={esHref} class:list={["lang-btn", { active: locale === "es" }]} aria-current={locale === "es" ? "page" : undefined}>
		ES
	</a>
</div>

<style>
	.lang-switcher {
		display: flex;
		gap: 0.25rem;
		background: rgba(0, 0, 0, 0.3);
		padding: 0.25rem;
		border-radius: 6px;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}
	.lang-btn {
		padding: 0.35rem 0.6rem;
		background: transparent;
		border: none;
		border-radius: 4px;
		color: #888;
		font-size: 0.75rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
	}
	.lang-btn:hover {
		color: #ccc;
	}
	.lang-btn.active {
		background: rgba(255, 123, 0, 0.2);
		color: rgb(255, 215, 0);
	}
</style>
