<!-- Language Switcher -->
<div class="lang-switcher">
  <button type="button" class="lang-btn" data-lang-toggle data-lang="en">EN</button>
  <button type="button" class="lang-btn" data-lang-toggle data-lang="es">ES</button>
</div>

<style>
  .lang-switcher {
    display: flex;
    gap: 0.25rem;
    background: rgba(0, 0, 0, 0.3);
    padding: 0.25rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .lang-btn {
    padding: 0.35rem 0.6rem;
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #888;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lang-btn:hover { color: #ccc; }
  .lang-btn.active, .lang-btn[data-lang-toggle][data-lang-toggle="active"] {
    background: rgba(255, 123, 0, 0.2);
    color: rgb(255, 215, 0);
  }
</style>

<script is:inline>
  // Sync button states when language changes
  function updateButtons() {
    var lang = localStorage.getItem('wiki-lang') || 'en';
    var btns = document.querySelectorAll('[data-lang-toggle]');
    btns.forEach(function(btn) {
      btn.classList.toggle('active', btn.dataset.lang === lang);
    });
  }
  
  // Update on load
  updateButtons();
  
  // Update on language change
  window.addEventListener('lang-changed', updateButtons);
</script>