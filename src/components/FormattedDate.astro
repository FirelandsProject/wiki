---
interface Props {
	date: Date;
	locale?: "en" | "es";
}

const { date, locale = "en" } = Astro.props;

const formatted = date.toLocaleDateString(locale === "es" ? "es-es" : "en-us", {
	year: "numeric",
	month: "short",
	day: "numeric",
});
---

<time datetime={date.toISOString()}>{formatted}</time>
