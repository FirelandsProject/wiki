---
import HeaderLink from "./HeaderLink.astro";
import Logo from "./Logo.astro";
import { SITE_TITLE, getBasePath } from "../consts";
import LangSwitcher from "./LangSwitcher.astro";
const base = getBasePath();
---

<header>
	<nav>
		<a href={base || '/'} class="logo-link">
			<Logo class="logo-svg" />
		</a>
		<div class="internal-links">
			<HeaderLink href={base || '/'} data-i18n="home">Home</HeaderLink>
			<HeaderLink href={`${base}/docs`} data-i18n="docs">Docs</HeaderLink>
			<HeaderLink href={`${base}/about`} data-i18n="about">About</HeaderLink>
		</div>
		<div class="header-right">
			<LangSwitcher />
			<div class="social-links">
			<a href="https://github.com/FirelandsProject" target="_blank">
				<span class="sr-only">Firelands Core Project GitHub repo</span>
				<svg
					viewBox="0 0 16 16"
					aria-hidden="true"
					width="32"
					height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 1em 2em;
		background: rgba(var(--black), 0.9);
		border-bottom: 2px solid rgb(var(--gray-light));
		box-shadow: 0 4px 10px rgba(0,0,0,0.5);
		backdrop-filter: blur(5px);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	.logo-link {
		display: flex;
		align-items: center;
		text-decoration: none;
		transition: all 0.3s ease;
		border-bottom: none !important;
	}
	.logo-link:hover {
		transform: scale(1.15);
		filter: drop-shadow(0 0 15px rgba(255, 123, 0, 0.6));
	}
	.logo-link::before {
		display: none;
	}
	.logo-svg {
		width: 40px;
		height: 40px;
		display: block;
		object-fit: contain;
	}


	
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.internal-links {
		display: flex;
		gap: 1.5rem;
	}
	nav a {
		padding: 0.5em 0;
		color: #ccc;
		text-decoration: none;
		font-family: 'Metamorphous', serif;
		font-size: 0.9em;
		transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		border-bottom: 2px solid transparent;
		position: relative;
	}
	nav a::before {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 2px;
		background: linear-gradient(90deg, var(--accent), var(--gold));
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 0.3s ease;
	}
	nav a:hover,
	nav a.active {
		color: rgb(var(--gold));
		text-shadow: 0 0 12px rgb(var(--accent));
		border-bottom-color: transparent;
	}
	nav a:hover::before,
	nav a.active::before {
		transform: scaleX(1);
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
		color: #ccc;
		transition: all 0.3s ease;
	}
    .social-links a:hover {
        color: rgb(var(--gold));
        filter: drop-shadow(0 0 8px rgb(var(--gold)));
        transform: scale(1.1);
    }

	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>

