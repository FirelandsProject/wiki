---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Post from "../../layouts/Post.astro";
import { DOC_ORDER, docTranslations } from "../../lib/docTranslations";

export async function getStaticPaths() {
	const posts = await getCollection("docs");

	const sortedPosts = posts.sort((a, b) => {
		const aIndex = DOC_ORDER.indexOf(a.id as (typeof DOC_ORDER)[number]);
		const bIndex = DOC_ORDER.indexOf(b.id as (typeof DOC_ORDER)[number]);
		const aPos = aIndex === -1 ? 999 : aIndex;
		const bPos = bIndex === -1 ? 999 : bIndex;
		return aPos - bPos;
	});

	return posts.map((post) => {
		const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);
		const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
		const nextPost =
			currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

		const titleData = docTranslations[post.id as keyof typeof docTranslations] ?? {
			en: post.data.title,
			es: post.data.title,
		};

		const prevTitles = prevPost
			? (docTranslations[prevPost.id as keyof typeof docTranslations] ?? {
					en: prevPost.data.title,
					es: prevPost.data.title,
				})
			: null;
		const nextTitles = nextPost
			? (docTranslations[nextPost.id as keyof typeof docTranslations] ?? {
					en: nextPost.data.title,
					es: nextPost.data.title,
				})
			: null;

		return {
			params: { slug: post.id },
			props: {
				post,
				prevPost,
				nextPost,
				titleEn: titleData.en,
				titleEs: titleData.es,
				prevTitleEn: prevTitles?.en,
				prevTitleEs: prevTitles?.es,
				nextTitleEn: nextTitles?.en,
				nextTitleEs: nextTitles?.es,
			},
		};
	});
}

type Props = {
	post: CollectionEntry<"docs">;
	prevPost: CollectionEntry<"docs"> | null;
	nextPost: CollectionEntry<"docs"> | null;
	titleEn: string;
	titleEs: string;
	prevTitleEn?: string;
	prevTitleEs?: string;
	nextTitleEn?: string;
	nextTitleEs?: string;
};

const {
	post,
	prevPost,
	nextPost,
	titleEn,
	titleEs,
	prevTitleEn,
	prevTitleEs,
	nextTitleEn,
	nextTitleEs,
} = Astro.props;
const { Content, headings } = await render(post);
---

<Post
	{...post.data}
	{headings}
	prevPost={prevPost}
	nextPost={nextPost}
	titleEn={titleEn}
	titleEs={titleEs}
	prevTitleEn={prevTitleEn}
	prevTitleEs={prevTitleEs}
	nextTitleEn={nextTitleEn}
	nextTitleEs={nextTitleEs}
>
	<Content />
</Post>
