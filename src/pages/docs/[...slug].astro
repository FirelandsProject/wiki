---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Post from "../../layouts/Post.astro";

export async function getStaticPaths() {
	const posts = await getCollection("docs");
	
	const order = [
		"getting-started",
		"architecture",
		"developer-setup",
		"database",
		"lua-scripting",
		"testing",
		"gm-commands"
	];

	const sortedPosts = posts.sort((a, b) => {
		const aIndex = order.indexOf(a.id);
		const bIndex = order.indexOf(b.id);
		const aPos = aIndex === -1 ? 999 : aIndex;
		const bPos = bIndex === -1 ? 999 : bIndex;
		return aPos - bPos;
	});

    const titles: Record<string, { en: string; es: string }> = {
        "getting-started": { en: "Getting Started", es: "Comenzar" },
        "architecture": { en: "Architecture", es: "Arquitectura" },
        "developer-setup": { en: "Developer Setup", es: "Configuración de Desarrollador" },
        "database": { en: "Database", es: "Base de Datos" },
        "lua-scripting": { en: "Lua Scripting", es: "Scripting Lua" },
        "testing": { en: "Testing", es: "Pruebas" },
        "gm-commands": { en: "GM Commands", es: "Comandos GM" }
    };

	return posts.map((post, index) => {
		const currentIndex = sortedPosts.findIndex(p => p.id === post.id);
		const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
		const nextPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
        
        const titleData = titles[post.id] || { en: post.data.title, es: post.data.title };
		
		return {
			params: { slug: post.id },
			props: { 
                post, 
                prevPost, 
                nextPost, 
                titleEn: titleData.en,
                titleEs: titleData.es
            },
		};
	});
}

type Props = {
	post: CollectionEntry<"docs">;
	prevPost: CollectionEntry<"docs"> | null;
	nextPost: CollectionEntry<"docs"> | null;
    titleEn: string;
    titleEs: string;
};

const { post, prevPost, nextPost, titleEn, titleEs } = Astro.props;
const { Content, headings } = await render(post);
---

<Post {...post.data} {headings} prevPost={prevPost} nextPost={nextPost} titleEn={titleEn} titleEs={titleEs}>
	<Content />
</Post>