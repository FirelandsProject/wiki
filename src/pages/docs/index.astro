---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { DOC_ORDER, docTranslations } from "../../lib/docTranslations";

const posts = await getCollection("docs");

const sortedPosts = posts.sort((a, b) => {
	const aIndex = DOC_ORDER.indexOf(a.id as (typeof DOC_ORDER)[number]);
	const bIndex = DOC_ORDER.indexOf(b.id as (typeof DOC_ORDER)[number]);
	const aPos = aIndex === -1 ? 999 : aIndex;
	const bPos = bIndex === -1 ? 999 : bIndex;
	return aPos - bPos;
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				flex: 1;
				width: 1200px !important;
                max-width: calc(100% - 2rem) !important;
                margin: auto;
                padding: 3rem 1rem;
			}
			section.masonry-wrapper {
				column-count: 3;
				column-gap: 1.5rem;
				width: 100%;
			}
			section.masonry-wrapper .masonry-item {
				break-inside: avoid;
				margin-bottom: 1.5rem;
			}
			.masonry-item {
				break-inside: avoid;
				margin-bottom: 1.5rem;
			}
			.doc-card {
				display: block;
				text-decoration: none;
                background: linear-gradient(145deg, rgba(30, 30, 30, 0.9), rgba(20, 20, 20, 0.95));
                border: 1px solid rgba(212, 175, 55, 0.15);
                padding: 1.5rem;
                border-radius: 12px;
                transition: all 0.3s ease;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
                position: relative;
                overflow: hidden;
			}
            .doc-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 3px;
                background: linear-gradient(90deg, rgba(212, 175, 55, 0.8), transparent);
            }
			.doc-card:hover {
				transform: translateY(-4px) scale(1.01);
                border-color: rgba(212, 175, 55, 0.5);
                box-shadow: 0 8px 30px rgba(212, 175, 55, 0.15);
            }
			.title {
				margin: 0 0 0.75rem 0;
				color: #d4af37;
				line-height: 1.3;
                font-family: 'Metamorphous', serif;
                font-size: 1.25rem;
			}
			.date {
				margin: 0 0 1rem 0;
				color: #888;
                font-size: 0.8rem;
                font-family: 'Inter', sans-serif;
			}
            .description {
                margin: 0;
                color: #aaa;
                font-size: 0.9rem;
                line-height: 1.6;
            }
            .order-badge {
                position: absolute;
                top: 1rem;
                right: 1rem;
                background: rgba(212, 175, 55, 0.15);
                color: #d4af37;
                padding: 0.25rem 0.5rem;
                border-radius: 4px;
                font-size: 0.75rem;
                font-family: 'Inter', sans-serif;
            }
			@media (max-width: 1024px) {
				section.masonry-wrapper {
					column-count: 2;
				}
			}
			@media (max-width: 640px) {
				section.masonry-wrapper {
					column-count: 1;
				}
			}
			.intro {
				text-align: center;
				margin-bottom: 3rem;
				padding: 2rem;
				background: rgba(0, 0, 0, 0.3);
				border-radius: 12px;
				border: 1px solid rgba(212, 175, 55, 0.1);
			}
			.intro h1 {
				margin: 0 0 1rem 0;
				color: rgb(var(--gold));
			}
			.intro-text {
				font-size: 1.2rem;
				color: #ccc;
				max-width: 600px;
				margin: 0 auto 1.5rem;
				line-height: 1.6;
			}
			.intro-hint {
				display: inline-block;
				background: rgba(255, 123, 0, 0.1);
				border: 1px solid rgba(255, 123, 0, 0.3);
				padding: 0.75rem 1.5rem;
				border-radius: 8px;
				color: rgb(var(--gold));
				font-size: 0.95rem;
			}
			.intro-hint strong {
				color: rgb(var(--accent));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="intro">
				<h1>
					<span class="lang-en">Documentation</span>
					<span class="lang-es">Documentación</span>
				</h1>
				<p class="intro-text">
					<span class="lang-en">Explore the complete Firelands Core documentation. Click any card below to dive into the topic you need.</span>
					<span class="lang-es">Explora la documentación completa de Firelands Core. Haz clic en cualquier tarjeta para profundizar en el tema que necesitas.</span>
				</p>
				<div class="intro-hint">
					<span class="lang-en">💡 Pro tip: Start with <strong>Getting Started</strong> if you're new!</span>
					<span class="lang-es">💡 Consejo: ¡Comienza con <strong>Comenzar</strong> si eres nuevo!</span>
				</div>
			</div>
			<section class="masonry-wrapper">
				{
					sortedPosts.map((post, index) => {
						const t = docTranslations[post.id as keyof typeof docTranslations];
						return (
							<div class="masonry-item">
								<a href={`/wiki/docs/${post.id}/`} class="doc-card">
									<span class="order-badge">#{index + 1}</span>
									<h3 class="title">
										<span class="lang-en">{t?.en ?? post.data.title}</span>
										<span class="lang-es">{t?.es ?? post.data.title}</span>
									</h3>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="description">
										<span class="lang-en">{t?.descEn ?? post.data.description}</span>
										<span class="lang-es">{t?.descEs ?? post.data.description}</span>
									</p>
								</a>
							</div>
						);
					})
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
