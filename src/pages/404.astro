---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, getBasePath } from "../consts";
const base = getBasePath();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`404: Lost in the Firelands | ${SITE_TITLE}`} description="You have wandered beyond the Firelands. The knowledge you seek has evaporated into the magmatic void." />
        <style>
            :root {
                --glitch-color: rgba(255, 77, 0, 0.5);
            }

            .error-wrapper {
                position: relative;
                min-height: 80vh;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                border-radius: 12px;
                background: radial-gradient(circle at center, rgba(255, 77, 0, 0.05) 0%, transparent 70%);
            }

            .scanner-line {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: linear-gradient(to right, transparent, rgba(255, 123, 0, 0.4), transparent);
                box-shadow: 0 0 15px rgba(255, 123, 0, 0.8);
                pointer-events: none;
                z-index: 5;
                animation: scan 4s linear infinite;
            }

            .error-container {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                z-index: 2;
                padding: 2rem;
            }

            .error-code {
                font-size: clamp(6rem, 15vw, 12rem);
                font-family: 'Metamorphous', serif;
                margin: 2rem 0;
                color: #fff;
                text-shadow: 
                    3px 3px 0px var(--glitch-color),
                    -3px -3px 0px rgba(255, 204, 0, 0.3);
                position: relative;
                animation: float 6s ease-in-out infinite;
            }

            .error-code span {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0.8;
            }

            .error-code span:nth-child(2) {
                color: #ff3300;
                animation: glitch-anim 3s infinite linear alternate-reverse;
                z-index: -1;
            }

            .error-title {
                font-size: clamp(1.5rem, 4vw, 3rem);
                margin: 0;
                color: rgb(var(--gold));
                text-transform: uppercase;
                letter-spacing: 0.2em;
                font-family: 'Metamorphous', serif;
                filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.4));
            }

            .divider {
                width: 150px;
                height: 2px;
                background: linear-gradient(to right, transparent, rgb(var(--accent)), transparent);
                margin: 1.5rem 0;
            }

            .error-message {
                font-size: 1.1rem;
                max-width: 500px;
                color: rgba(255, 255, 255, 0.7);
                line-height: 1.6;
                margin-bottom: 2.5rem;
            }

            @keyframes scan {
                0% { top: -5%; }
                100% { top: 105%; }
            }

            @keyframes float {
                0%, 100% { transform: translateY(0); }
                50% { transform: translateY(-20px); }
            }

            @keyframes glitch-anim {
                0% { clip-path: inset(40% 0 61% 0); transform: translate(-5px); }
                20% { clip-path: inset(92% 0 1% 0); transform: translate(5px); }
                40% { clip-path: inset(43% 0 1% 0); transform: translate(-5px); }
                60% { clip-path: inset(25% 0 58% 0); transform: translate(5px); }
                80% { clip-path: inset(54% 0 7% 0); transform: translate(-5px); }
                100% { clip-path: inset(58% 0 43% 0); transform: translate(5px); }
            }

            .embers {
                position: absolute;
                width: 100%;
                height: 100%;
                pointer-events: none;
            }

            .ember {
                position: absolute;
                bottom: -20px;
                background: radial-gradient(circle, #ffca00, #ff4c00);
                border-radius: 50%;
                opacity: 0;
                filter: blur(1px);
                animation: float-ember var(--duration) linear infinite;
                animation-delay: var(--delay);
            }

            @keyframes float-ember {
                0% { transform: translateY(0) translateX(0) scale(1); opacity: 0; }
                10% { opacity: 0.8; }
                100% { transform: translateY(-100vh) translateX(var(--spread)) scale(0.5); opacity: 0; }
            }

            .glow-orb {
                position: absolute;
                width: 300px;
                height: 300px;
                background: radial-gradient(circle, rgba(255, 77, 0, 0.15), transparent 70%);
                filter: blur(50px);
                pointer-events: none;
                z-index: 1;
                border-radius: 50%;
                animation: pulse-orb 8s ease-in-out infinite;
            }

            @keyframes pulse-orb {
                0%, 100% { transform: scale(1); opacity: 0.5; }
                50% { transform: scale(1.5); opacity: 0.8; }
            }
        </style>
	</head>
	<body>
		<Header title={SITE_TITLE} />
		<main>
            <div class="error-wrapper">
                <div class="scanner-line"></div>
                <div class="glow-orb" style="top: 20%; left: 20%;"></div>
                <div class="glow-orb" style="bottom: 10%; right: 10%; animation-delay: -4s;"></div>
                <div class="embers" id="embers-container"></div>
                
                <div class="error-container">
                    <h1 class="error-code">
                        404
                        <span>404</span>
                    </h1>
                    <h2 class="error-title">Plane stabilized... in Nothingness</h2>
                    <div class="divider"></div>
                    <p class="error-message">
                        It seems you have wandered beyond the Firelands. The knowledge you seek has evaporated into the magmatic void.
                    </p>

                    <a href={base || '/'} class="cta-button">
                        🌋 Return to Safety
                    </a>
                </div>
            </div>
		</main>

		<Footer />

        <script>
            const container = document.getElementById('embers-container');
            if (container) {
                const count = 40;
                for (let i = 0; i < count; i++) {
                    const ember = document.createElement('div');
                    ember.className = 'ember';
                    
                    const size = Math.random() * 5 + 2;
                    const left = Math.random() * 100;
                    const duration = Math.random() * 4 + 4;
                    const delay = Math.random() * 8;
                    const spread = (Math.random() - 0.5) * 200;
                    
                    ember.style.width = `${size}px`;
                    ember.style.height = `${size}px`;
                    ember.style.left = `${left}%`;
                    ember.style.setProperty('--duration', `${duration}s`);
                    ember.style.setProperty('--delay', `${delay}s`);
                    ember.style.setProperty('--spread', `${spread}px`);
                    
                    container.appendChild(ember);
                }
            }
        </script>
	</body>
</html>

