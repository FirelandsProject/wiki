---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import DocsIndex from "../../../components/DocsIndex.astro";
import { SITE_TITLE, getBasePath } from "../../../consts";
import { t } from "../../../i18n/ui";

const base = getBasePath();
const locale = "es";
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={`${t(locale, "documentation")} | ${SITE_TITLE}`} description={t(locale, "docsIntro")} locale={locale} />
		<style>
			main {
				flex: 1;
				width: 1200px !important;
				max-width: calc(100% - 2rem) !important;
				margin: auto;
				padding: 3rem 1rem;
			}
		</style>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<DocsIndex locale={locale} base={base} />
		</main>
		<Footer locale={locale} />
	</body>
</html>
