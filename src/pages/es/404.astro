---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, getBasePath } from "../../consts";
import { localePath } from "../../i18n/utils";
import { t } from "../../i18n/ui";

const base = getBasePath();
const locale = "es";
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead
			title={`404 | ${SITE_TITLE}`}
			description={t(locale, "errorMessage")}
			locale={locale}
		/>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<div class="error-wrapper">
				<h1 class="error-code">404</h1>
				<h2 class="error-title">{t(locale, "errorTitle")}</h2>
				<p class="error-message">{t(locale, "errorMessage")}</p>
				<a href={localePath(locale, "/", base)} class="cta-button">{t(locale, "returnHome")}</a>
			</div>
		</main>
		<Footer locale={locale} />
	</body>
</html>

<style>
	.error-wrapper {
		min-height: 60vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 2rem;
	}
	.error-code {
		font-size: 6rem;
		font-family: "Metamorphous", serif;
		color: rgb(var(--gold));
		margin: 0;
	}
	.error-title {
		color: rgb(var(--accent));
	}
	.error-message {
		max-width: 500px;
		color: #aaa;
		line-height: 1.6;
	}
</style>
