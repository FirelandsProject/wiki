---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header title={SITE_TITLE} />
		<main>
            <div class="hero">
                <h1 class="glow-text">Firelands Core Wiki</h1>
                <p class="subtitle">The Ultimate Open Source & Modular Solution for MMO Development</p>
            </div>
            
            <div class="prose">
                <h2>Project Pillars</h2>
                <p>
                    Firelands Core is an educational project aimed at understanding the architecture and mechanics of MMORPG servers, specifically focused on the World of Warcraft: Cataclysm expansion.
                </p>
                
                <div class="features-grid">
                    <div class="feature-card">
                        <h3>🔥 Playable</h3>
                        <p>A stable, production-ready server application with strict CI/CD pipelines to ensure code excellence.</p>
                    </div>
                    <div class="feature-card">
                        <h3>🛡️ Open Source</h3>
                        <p>Fully licensed under GNU AGPL V3.0. Community-driven development for the future of MMO emulation.</p>
                    </div>
                    <div class="feature-card">
                        <h3>🧩 Modular</h3>
                        <p>Extend your core with custom modules without touching the blizzlike base. Pure flexibility.</p>
                    </div>
                </div>

                <hr />
                
                <p style="text-align: center;">
                    <a href="/wiki/docs" class="cta-button">Enter Knowledge Base</a>
                </p>
            </div>
		</main>

		<Footer />
	</body>
</html>
