---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, getBasePath } from "../consts";
const base = getBasePath();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header title={SITE_TITLE} />
		<main>
            <div class="hero">
                <h1 class="glow-text">Firelands Wiki</h1>
                <p class="subtitle">Documentation for firelands-next - WoW Cataclysm Emulator (4.3.4)</p>
            </div>
            
            <div class="prose">
                <h2>About</h2>
                <p>
                    Firelands is a WoW Cataclysm emulator built with modern software engineering practices, featuring a clean hexagonal architecture and comprehensive test coverage.
                </p>
                
                <div class="features-grid">
                    <div class="feature-card">
                        <h3>🏗️ Hexagonal Architecture</h3>
                        <p>Clean separation between domain, application, and infrastructure layers with dependency inversion.</p>
                    </div>
                    <div class="feature-card">
                        <h3>🧪 Test-Driven Development</h3>
                        <p>Business logic driven by tests using GoogleTest and GMock for comprehensive coverage.</p>
                    </div>
                    <div class="feature-card">
                        <h3>⚡ Modern C++17</h3>
                        <p>Built with C++17, CMake, and Ninja for fast builds and cross-platform support.</p>
                    </div>
                </div>

                <hr />
                
                <p style="text-align: center;">
                    <a href={`${base}/docs`} class="cta-button">Enter Knowledge Base</a>
                </p>
            </div>
		</main>

		<Footer />
	</body>
</html>
